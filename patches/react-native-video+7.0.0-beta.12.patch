+package com.twg.video.core.player
+
+import android.content.Context
+import android.os.Build
+import android.os.Handler
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.Renderer
+import androidx.media3.exoplayer.mediacodec.MediaCodecSelector
+import androidx.media3.exoplayer.video.MediaCodecVideoRenderer
+import androidx.media3.exoplayer.video.VideoRendererEventListener
+
+/**
+ * The Android emulator's decoders (goldfish and the software c2.android ones) draw black into the buffers that
+ * MediaCodec.setOutputSurface carries over to a new surface: the placeholder surface the codec starts on before the
+ * view's own surface is there, or the SurfaceView PlayerView swapped for the TextureView one. The video stays black
+ * with a frame now and then (a flicker). On the emulator only, media3's own workaround for devices with a broken
+ * setOutputSurface is turned on: no placeholder surface, and the codec is made again on each new surface.
+ */
+@OptIn(UnstableApi::class)
+class EmulatorSafeRenderersFactory(context: Context) : DefaultRenderersFactory(context) {
+  override fun buildVideoRenderers(
+    context: Context,
+    extensionRendererMode: Int,
+    mediaCodecSelector: MediaCodecSelector,
+    enableDecoderFallback: Boolean,
+    eventHandler: Handler,
+    eventListener: VideoRendererEventListener,
+    allowedVideoJoiningTimeMs: Long,
+    out: ArrayList<Renderer>
+  ) {
+    super.buildVideoRenderers(
+      context, extensionRendererMode, mediaCodecSelector, enableDecoderFallback,
+      eventHandler, eventListener, allowedVideoJoiningTimeMs, out
+    )
+    if (!isEmulator) return
+
+    val index = out.indexOfFirst { it is MediaCodecVideoRenderer }
+    if (index < 0) return
+    val adapterFactory = codecAdapterFactory
+    out[index] = object : MediaCodecVideoRenderer(
+      context, adapterFactory, mediaCodecSelector, allowedVideoJoiningTimeMs, enableDecoderFallback,
+      eventHandler, eventListener, MAX_DROPPED_VIDEO_FRAME_COUNT_TO_NOTIFY
+    ) {
+      override fun codecNeedsSetOutputSurfaceWorkaround(name: String): Boolean = true
+    }
+  }
+
+  private companion object {
+    val isEmulator = Build.HARDWARE == "ranchu" || Build.HARDWARE == "goldfish"
+  }
+}
